{
  "name": "digitron-associates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node backend/server.js",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm run test:backend",
    "test:backend": "node backend/tests/admin.test.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.100.9",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "mongodb": "^6.13.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.2.5",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prisma": "^5.22.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  }
}
